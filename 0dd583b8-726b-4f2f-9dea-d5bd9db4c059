:italic;}\n  .badge{margin-left:auto;background:var(--accent);color:#fff;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;letter-spacing:.08em;}\n  .key-bar{background:#fff8f3;border-bottom:1px solid #f0d9c8;padding:10px 20px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}\n  .key-bar label{font-size:12px;color:var(--muted);white-space:nowrap;}\n  .key-bar input{flex:1;min-width:180px;font-family:monospace;font-size:12px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--paper);color:var(--ink);outline:none;}\n  .key-bar button{padding:6px 14px;background:var(--accent);color:#fff;border:none;border-radius:6px;font-size:12px;cursor:pointer;}\n  #key-status{font-size:12px;}\n  nav{background:var(--cream);border-bottom:1px solid var(--border);display:flex;overflow-x:auto;padding:0 16px;}\n  nav button{background:none;border:none;border-bottom:3px solid transparent;padding:12px 14px 9px;font-size:13px;font-weight:500;color:var(--muted);cursor:pointer;white-space:nowrap;}\n  nav button.active{color:var(--accent);border-bottom-color:var(--accent);}\n  main{max-width:700px;margin:0 auto;padding:24px 16px 60px;}\n  .sec{display:none;} .sec.active{display:block;}\n  h1{font-family:Georgia,serif;font-size:22px;margin-bottom:4px;}\n  .sub{color:var(--muted);font-size:13px;margin-bottom:20px;}\n  .card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:20px;}\n  label{display:block;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:5px;margin-top:14px;}\n  label:first-child{margin-top:0;}\n  input[type=\"text\"],textarea,select{width:100%;font-family:sans-serif;font-size:13px;color:var(--ink);background:var(--paper);border:1px solid var(--border);border-radius:7px;padding:9px 12px;outline:none;resize:vertical;}\n  input[type=\"text\"]:focus,textarea:focus,select:focus{border-color:var(--accent);background:#fff;}\n  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}\n  @media(max-width:480px){.row2{grid-template-columns:1fr;}}\n  .btn-row{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap;}\n  .btn{padding:10px 20px;border-radius:8px;border:none;font-size:13px;font-weight:500;cursor:pointer;}\n  .btn:disabled{opacity:.45;cursor:not-allowed;}\n  .btn-p{background:var(--accent);color:#fff;}\n  .btn-p:hover:not(:disabled){opacity:.85;}\n  .btn-s{background:var(--cream);color:var(--ink);border:1px solid var(--border);}\n  .output{margin-top:16px;background:var(--paper);border:1px solid var(--border);border-radius:8px;padding:16px;font-size:14px;line-height:1.8;white-space:pre-wrap;font-family:Georgia,serif;position:relative;display:none;}\n  .output.visible{display:block;}\n  .output.loading{color:var(--muted);font-style:italic;font-family:sans-serif;}\n  .output.error{color:#c62828;font-family:sans-serif;font-size:13px;}\n  .copy-btn{position:absolute;top:10px;right:10px;background:var(--cream);border:1px solid var(--border);border-radius:5px;padding:3px 10px;font-size:12px;cursor:pointer;color:var(--muted);}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cheader\u003e\n  \u003cdiv class=\"logo\"\u003eDiário de \u003cspan\u003eViagens\u003c/span\u003e\u003c/div\u003e\n  \u003cdiv class=\"badge\"\u003e✦ AGENTE IA\u003c/div\u003e\n\u003c/header\u003e\n\u003cdiv class=\"key-bar\"\u003e\n  \u003clabel for=\"apikey\"\u003eChave API Anthropic:\u003c/label\u003e\n  \u003cinput type=\"password\" id=\"apikey\" placeholder=\"sk-ant-...\"\u003e\n  \u003cbutton onclick=\"guardarChave()\"\u003eGuardar\u003c/button\u003e\n  \u003cspan id=\"key-status\"\u003e\u003c/span\u003e\n\u003c/div\u003e\n\u003cnav\u003e\n  \u003cbutton class=\"active\" onclick=\"tab('artigo',this)\"\u003e✍️ Artigo\u003c/button\u003e\n  \u003cbutton onclick=\"tab('legendas',this)\"\u003e📸 Legendas\u003c/button\u003e\n  \u003cbutton onclick=\"tab('seo',this)\"\u003e🔍 SEO\u003c/button\u003e\n  \u003cbutton onclick=\"tab('itinerario',this)\"\u003e🗺️ Itinerário\u003c/button\u003e\n  \u003cbutton onclick=\"tab('tendencias',this)\"\u003e📈 Temas em Alta\u003c/button\u003e\n\u003c/nav\u003e\n\u003cmain\u003e\n\n\u003cdiv id=\"artigo\" class=\"sec active\"\u003e\n  \u003ch1\u003eEscrever Artigo\u003c/h1\u003e\u003cp class=\"sub\"\u003eCola as tuas notas e o agente transforma-as num artigo completo.\u003c/p\u003e\n  \u003cdiv class=\"card\"\u003e\n    \u003cdiv class=\"row2\"\u003e\n      \u003cdiv\u003e\u003clabel\u003eDestino\u003c/label\u003e\u003cinput type=\"text\" id=\"art-dest\" placeholder=\"ex: Mirandela\"\u003e\u003c/div\u003e\n      \u003cdiv\u003e\u003clabel\u003eTom\u003c/label\u003e\u003cselect id=\"art-tom\"\u003e\u003coption value=\"pessoal e narrativo\"\u003ePessoal e narrativo\u003c/option\u003e\u003coption value=\"informativo e prático\"\u003eInformativo e prático\u003c/option\u003e\u003coption value=\"poético e contemplativo\"\u003ePoético\u003c/option\u003e\u003coption value=\"guia de viagem clássico\"\u003eGuia clássico\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003clabel\u003eAs tuas notas de viagem\u003c/label\u003e\n    \u003ctextarea id=\"art-notas\" rows=\"6\" placeholder=\"Ex: Chegámos a Mirandela ao final da tarde. O rio Tua estava calmo…\"\u003e\u003c/textarea\u003e\n    \u003clabel\u003eComprimento\u003c/label\u003e\n    \u003cselect id=\"art-comp\"\u003e\u003coption value=\"curto (300-400 palavras)\"\u003eCurto\u003c/option\u003e\u003coption value=\"médio (600-800 palavras)\" selected\u003eMédio\u003c/option\u003e\u003coption value=\"longo (1000+ palavras)\"\u003eLongo\u003c/option\u003e\u003c/select\u003e\n    \u003cdiv class=\"btn-row\"\u003e\n      \u003cbutton class=\"btn btn-p\" onclick=\"gerar('artigo')\"\u003e✦ Gerar Artigo\u003c/button\u003e\n      \u003cbutton class=\"btn btn-s\" onclick=\"limpar('art-notas','out-artigo')\"\u003eLimpar\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv id=\"out-artigo\" class=\"output\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv id=\"legendas\" class=\"sec\"\u003e\n  \u003ch1\u003eLegendas para Redes Sociais\u003c/h1\u003e\u003cp class=\"sub\"\u003eDescreve a foto e recebe legendas prontas com hashtags.\u003c/p\u003e\n  \u003cdiv class=\"card\"\u003e\n    \u003clabel\u003eDestino / contexto\u003c/label\u003e\u003cinput type=\"text\" id=\"leg-dest\" placeholder=\"ex: Pôr do sol no Douro\"\u003e\n    \u003clabel\u003eDescrição da foto/cena\u003c/label\u003e\u003ctextarea id=\"leg-desc\" rows=\"4\" placeholder=\"ex: Foto aérea de drone ao entardecer, luz dourada, rio ao fundo…\"\u003e\u003c/textarea\u003e\n    \u003clabel\u003ePlataformas\u003c/label\u003e\u003cselect id=\"leg-plat\"\u003e\u003coption\u003eInstagram\u003c/option\u003e\u003coption value=\"Instagram e Facebook\"\u003eInstagram e Facebook\u003c/option\u003e\u003coption value=\"Instagram, Facebook e TikTok\"\u003eInstagram, Facebook e TikTok\u003c/option\u003e\u003c/select\u003e\n    \u003cdiv class=\"btn-row\"\u003e\n      \u003cbutton class=\"btn btn-p\" onclick=\"gerar('legendas')\"\u003e✦ Gerar Legendas\u003c/button\u003e\n      \u003cbutton class=\"btn btn-s\" onclick=\"limpar('leg-desc','out-legendas')\"\u003eLimpar\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv id=\"out-legendas\" class=\"output\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv id=\"seo\" class=\"sec\"\u003e\n  \u003ch1\u003eSEO \u0026 Palavras-chave\u003c/h1\u003e\u003cp class=\"sub\"\u003eAnalisa o teu artigo e otimiza para os motores de pesquisa.\u003c/p\u003e\n  \u003cdiv class=\"card\"\u003e\n    \u003clabel\u003eArtigo ou tema\u003c/label\u003e\u003ctextarea id=\"seo-texto\" rows=\"7\" placeholder=\"Cola aqui o teu artigo ou descreve o tema…\"\u003e\u003c/textarea\u003e\n    \u003clabel\u003eMercado alvo\u003c/label\u003e\u003cselect id=\"seo-pais\"\u003e\u003coption\u003ePortugal\u003c/option\u003e\u003coption value=\"Portugal e Brasil\"\u003ePortugal e Brasil\u003c/option\u003e\u003coption value=\"mercado internacional em português\"\u003eInternacional (PT)\u003c/option\u003e\u003c/select\u003e\n    \u003cdiv class=\"btn-row\"\u003e\n      \u003cbutton class=\"btn btn-p\" onclick=\"gerar('seo')\"\u003e✦ Analisar SEO\u003c/button\u003e\n      \u003cbutton class=\"btn btn-s\" onclick=\"limpar('seo-texto','out-seo')\"\u003eLimpar\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv id=\"out-seo\" class=\"output\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv id=\"itinerario\" class=\"sec\"\u003e\n  \u003ch1\u003eSugerir Itinerário\u003c/h1\u003e\u003cp class=\"sub\"\u003eCria um itinerário detalhado e pronto a publicar.\u003c/p\u003e\n  \u003cdiv class=\"card\"\u003e\n    \u003cdiv class=\"row2\"\u003e\n      \u003cdiv\u003e\u003clabel\u003eDestino\u003c/label\u003e\u003cinput type=\"text\" id=\"itin-dest\" placeholder=\"ex: Macedo de Cavaleiros\"\u003e\u003c/div\u003e\n      \u003cdiv\u003e\u003clabel\u003eDuração\u003c/label\u003e\u003cselect id=\"itin-dur\"\u003e\u003coption value=\"1 dia\"\u003e1 dia\u003c/option\u003e\u003coption value=\"fim de semana (2 dias)\" selected\u003eFim de semana\u003c/option\u003e\u003coption value=\"3 dias\"\u003e3 dias\u003c/option\u003e\u003coption value=\"1 semana\"\u003e1 semana\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003clabel\u003eTipo de viajante\u003c/label\u003e\n    \u003cselect id=\"itin-tipo\"\u003e\u003coption value=\"fotógrafo e amante da natureza\"\u003eFotógrafo / natureza\u003c/option\u003e\u003coption value=\"cultural e gastronómico\"\u003eCultural e gastronómico\u003c/option\u003e\u003coption value=\"aventura e desporto\"\u003eAventura e desporto\u003c/option\u003e\u003coption value=\"família com crianças\"\u003eFamília com crianças\u003c/option\u003e\u003coption value=\"casal em escapadinha romântica\"\u003eCasal / romântico\u003c/option\u003e\u003c/select\u003e\n    \u003clabel\u003eInteresses específicos (opcional)\u003c/label\u003e\u003cinput type=\"text\" id=\"itin-inter\" placeholder=\"ex: fotografia de drone, gastronomia local…\"\u003e\n    \u003cdiv class=\"btn-row\"\u003e\n      \u003cbutton class=\"btn btn-p\" onclick=\"gerar('itinerario')\"\u003e✦ Criar Itinerário\u003c/button\u003e\n      \u003cbutton class=\"btn btn-s\" onclick=\"limpar('itin-inter','out-itinerario')\"\u003eLimpar\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv id=\"out-itinerario\" class=\"output\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv id=\"tendencias\" class=\"sec\"\u003e\n  \u003ch1\u003eTemas em Alta\u003c/h1\u003e\u003cp class=\"sub\"\u003eDescobre ideias de artigos com potencial de pesquisa elevado.\u003c/p\u003e\n  \u003cdiv class=\"card\"\u003e\n    \u003clabel\u003eFoco do blog\u003c/label\u003e\n    \u003cselect id=\"tend-foco\"\u003e\u003coption value=\"viagens em Portugal, especialmente norte e interior\"\u003eNorte e interior de Portugal\u003c/option\u003e\u003coption value=\"viagens em Portugal\"\u003ePortugal geral\u003c/option\u003e\u003coption value=\"viagens na Europa\"\u003eEuropa\u003c/option\u003e\u003coption value=\"viagens de aventura e natureza\"\u003eAventura e natureza\u003c/option\u003e\u003coption value=\"road trips e viagens de carro\"\u003eRoad trips\u003c/option\u003e\u003c/select\u003e\n    \u003cdiv class=\"row2\"\u003e\n      \u003cdiv\u003e\u003clabel\u003eÉpoca do ano\u003c/label\u003e\u003cselect id=\"tend-epoca\"\u003e\u003coption value=\"primavera\"\u003ePrimavera\u003c/option\u003e\u003coption value=\"verão\"\u003eVerão\u003c/option\u003e\u003coption value=\"outono\"\u003eOutono\u003c/option\u003e\u003coption value=\"inverno\"\u003eInverno\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\n      \u003cdiv\u003e\u003clabel\u003eNº de sugestões\u003c/label\u003e\u003cselect id=\"tend-num\"\u003e\u003coption value=\"5\"\u003e5 temas\u003c/option\u003e\u003coption value=\"10\" selected\u003e10 temas\u003c/option\u003e\u003c/select\u003e\u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"btn-row\"\u003e\u003cbutton class=\"btn btn-p\" onclick=\"gerar('tendencias')\"\u003e✦ Descobrir Temas\u003c/button\u003e\u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv id=\"out-tendencias\" class=\"output\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003c/main\u003e\n\u003cscript\u003e\nlet API_KEY = localStorage.getItem('blog_api_key') || '';\nif(API_KEY){document.getElementById('apikey').value=API_KEY;document.getElementById('key-status').textContent='✅ Chave guardada';document.getElementById('key-status').style.color='#2e7d32';}\n\nfunction guardarChave(){\n  const k=document.getElementById('apikey').value.trim();\n  if(!k)return alert('Cola a tua chave API primeiro.');\n  API_KEY=k;localStorage.setItem('blog_api_key',k);\n  document.getElementById('key-status').textContent='✅ Guardada!';\n  document.getElementById('key-status').style.color='#2e7d32';\n}\n\nfunction tab(id,btn){\n  document.querySelectorAll('.sec').forEach(s=\u003es.classList.remove('active'));\n  document.querySelectorAll('nav button').forEach(b=\u003eb.classList.remove('active'));\n  document.getElementById(id).classList.add('active');\n  btn.classList.add('active');\n}\n\nfunction limpar(inputId,outputId){\n  const el=document.getElementById(inputId);if(el)el.value='';\n  setOut(outputId,'','');\n}\n\nfunction setOut(id,text,state){\n  const el=document.getElementById(id);\n  el.className='output';el.innerHTML='';\n  if(!text\u0026\u0026!state)return;\n  el.classList.add('visible');\n  if(state==='loading'){el.classList.add('loading');el.textContent='A gerar…';return;}\n  if(state==='error'){el.classList.add('error');el.textContent='⚠️ '+text;return;}\n  const btn=document.createElement('button');\n  btn.className='copy-btn';btn.textContent='Copiar';\n  btn.onclick=()=\u003e{navigator.clipboard.writeText(text);btn.textContent='Copiado ✓';setTimeout(()=\u003ebtn.textContent='Copiar',2000);};\n  el.appendChild(btn);el.appendChild(document.createTextNode(text));\n}\n\nfunction getPrompt(tipo){\n  if(tipo==='artigo'){\n    const dest=document.getElementById('art-dest').value.trim();\n    const notas=document.getElementById('art-notas').value.trim();\n    const tom=document.getElementById('art-tom').value;\n    const comp=document.getElementById('art-comp').value;\n    if(!notas){alert('Escreve as tuas notas.');return null;}\n    return `És um escritor de viagens português com estilo ${tom}. Com base nestas notas${dest?' sobre '+dest:''}, escreve um artigo ${comp} para um blog de viagens em português de Portugal. Título apelativo, introdução envolvente, desenvolvimento rico, conclusão inspiradora. Escreve apenas o artigo.\\n\\nNOTAS:\\n${notas}`;\n  }\n  if(tipo==='legendas'){\n    const dest=document.getElementById('leg-dest').value.trim();\n    const desc=document.getElementById('leg-desc').value.trim();\n    const plat=document.getElementById('leg-plat').value;\n    if(!desc){alert('Descreve a foto.');return null;}\n    return `Especialista em redes sociais para blogs de viagens. Cria legendas em português de Portugal para ${plat}. Contexto: ${dest?dest+' — ':''}${desc}. Para cada plataforma, 2 versões: emocional/poética e prática/informativa. Inclui hashtags no final de cada legenda.`;\n  }\n  if(tipo==='seo'){\n    const texto=document.getElementById('seo-texto').value.trim();\n    const pais=document.getElementById('seo-pais').value;\n    if(!texto){alert('Cola o texto.');return null;}\n    return `Especialista SEO para blogs de viagens em ${pais}. Analisa e fornece:\\n1. TÍTULO SEO (máx 60 caract)\\n2. META DESCRIÇÃO (máx 155 caract)\\n3. PALAVRA-CHAVE PRINCIPAL\\n4. PALAVRAS-CHAVE SECUNDÁRIAS (8-10 long-tail)\\n5. TÍTULO ALTERNATIVO para redes sociais\\n6. 3 DICAS de melhoria SEO\\n\\nCONTEÚDO:\\n${texto}`;\n  }\n  if(tipo==='itinerario'){\n    const dest=document.getElementById('itin-dest').value.trim();\n    const dur=documen